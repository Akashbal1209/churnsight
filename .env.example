# Copy to .env and fill in. Never commit .env.
# LLM_PROVIDER: "anthropic" for live LLM calls, or "none" to use the cached outputs in artifacts/
LLM_PROVIDER=none
# Model id from your provider's documentation (required when LLM_PROVIDER=anthropic)
LLM_MODEL=
# API key for the provider (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Optional: Slack incoming webhook for the weekly report
SLACK_WEBHOOK_URL=
