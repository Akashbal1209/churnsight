# Copy to .env and fill in. Never commit .env.
# LLM_PROVIDER: "anthropic" for live LLM calls, or "none" to run without an LLM (default)
LLM_PROVIDER=none
# Model id from your provider's documentation (required when LLM_PROVIDER=anthropic)
LLM_MODEL=
# API key for the provider (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
